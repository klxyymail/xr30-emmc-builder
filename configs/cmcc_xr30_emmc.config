# ============================================================================
#  CMCC XR30 eMMC 固件配置
#
#  本文件只写固件配置（CONFIG_PACKAGE_xxx=y）
#  源码地址 / 机型 / feeds / 定制项 均在 workflow 文件中定义
#
#  改插件 → 在这里加/减 CONFIG_PACKAGE_xxx=y
#  改源码 / IP / 主题 → 改 .github/workflows/cmcc_xr30_emmc.yml 顶部 env 段
# ============================================================================


# ============================================================================
#  构建选项（非插件，但决定编译速度）
# ============================================================================
# v1.7.11 新增：启用 ccache 编译器缓存
#
#   【这是个隐藏很久的性能杀手】
#     实测本次运行（#8，3h16m）恢复到的 ccache 缓存只有 207 bytes，
#     .ccache 目录 4.0K —— 说明 ccache 【从未真正生效过】。
#
#     原因：workflow 里虽然设置了 CCACHE_MAXSIZE=2G、也 restore/save 了
#     openwrt/.ccache，但 OpenWrt 是否使用 ccache 由 .config 里的
#     CONFIG_CCACHE 决定。配置里一直没有这一项（默认 n），
#     于是编译器根本没被 ccache 包装，缓存目录永远是空的。
#     ⇒ 每次都是【冷编译】，这是 3-4 小时耗时的主因之一。
#
#   启用后：工具链与大部分 C/C++ 包可命中缓存，
#           重编译（改配置后重跑）耗时会显著下降。
#           首次生效仍需完整编译一次来填充缓存。
#
#   注意：ccache 只对 C/C++ 有效，Go 项目（xray-core 等）不受影响。
CONFIG_CCACHE=y


# ============================================================================
#  零、硬件加速（HNAT / PPE / WED）—— 保留，出厂默认关闭
#
#      ⚠ v1.5.0 曾尝试【彻底移除】硬件加速，本版本已回退。
#        原因：移除后本机彻底失去 NAT 性能选项，且用户反馈
#        更希望能自行切换。现恢复为「保留但默认关闭」。
#
#      defconfig 里默认编译并【开启】硬件加速：
#        · CONFIG_PACKAGE_luci-app-turboacc-mtk=y      加速开关界面
#        · CONFIG_PACKAGE_kmod-mediatek_hnat=y         硬件 NAT 内核模块
#        · CONFIG_PACKAGE_kmod-warp=y                  WED（WiFi 硬件加速）
#      且 mtk_hnat 驱动初始化成功后会执行 hook_toggle = 1
#      （源码 target/linux/mediatek/files-6.6/.../mtk_hnat/hnat.c）。
#
#      ⇒ 这里【不做任何 is not set】，让 defconfig 的 =y 生效，
#        保持界面与内核模块都在；出厂默认【关闭】由 workflow 的
#        HW_OFFLOAD=0 实现（改写 turboacc 的 uci-defaults）。
#        刷机后可在 LuCI「Turbo ACC 网络加速」页面随时手动开启/关闭。
#
#      ⚠ 为什么不能只删界面：没有 turboacc 就没人去写
#        /sys/kernel/debug/hnat/hook_toggle，HNAT 会一直开着且无法关闭，
#        代理与 OAF 将永久失效。所以要么全保留，要么全删，不能只删界面。
#
#      保留 kmod-tcp-bbr：BBR 是纯拥塞控制算法，与硬件加速无关。
# ============================================================================
CONFIG_PACKAGE_kmod-tcp-bbr=y


# ============================================================================
#  一、主题
# ============================================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y


# ============================================================================
#  二、PassWall（官方源内置 v25.12.16）
# ============================================================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
#   ↑ v1.7.13【关键修正】：v1.7.12 我只改了 INCLUDE_V2ray_Geoview，
#     但那个符号在 PassWall 源码里根本不存在 —— 改了个寂寞，geoview 照旧被拉入。
#
#     实测证据（2026-09-10 那轮完整日志）：
#         03:14:01  make[3] -C feeds/packages/net/geoview compile
#         03:14:04  ERROR: package/feeds/packages/geoview failed to build.
#     —— 改了 v1.7.12 之后依旧失败，证明符号名写错了。
#
#     查证 PassWall 源码 luci-app-passwall/Makefile，真实符号是：
#         config PACKAGE_luci-app-passwall_INCLUDE_Geoview     ← 注意【没有】V2ray_ 前缀
#             bool "Include Geoview"
#             select PACKAGE_geoview
#             default y if aarch64||arm||i386||x86_64
#
#     两个致命点叠加：
#       ① select 的优先级高于 is not set
#          ⇒ 单独写 "# CONFIG_PACKAGE_geoview is not set" 完全挡不住
#       ② default y if aarch64，MT7981 正是 aarch64
#          ⇒ 即便配置里不写，它也会自动开启
#
#     这与 ssr-plus 的 INCLUDE_Mihomo 是同一类坑（无 depends on 母包、
#     aarch64 下 default y）。通用教训：遇到「莫名被拉入编译的包」，
#     必须追到 select 它的【上游开关的真实符号名】，只删下游包名无效。
#
#     geoview 仅用于 Sing-box 分流（PassWall 25.3.9+ 起依赖它从 Geofile
#     生成规则集），本配置走 Xray 分流，不需要。
#
#     保险起见两个名字都写（不同 PassWall 版本命名有差异），
#     并在 workflow 中额外删除 geoview 包定义目录做兜底。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y

# 重量级可选（Go/Rust，编译慢，按需开启）：
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y


# ============================================================================
#  三、luci-app-ssr-plus —— 已移除（v1.6.0）
#
#      移除原因：与 PassWall 同为透明代理实现，二者会争抢
#      nftables 规则与 DNS 重定向端口，不能同时使用。
#      当前主力为 PassWall（VLESS 场景更稳、依赖更少）。
#
#      注：helloworld feed 仍保留在 workflow 中，因为
#        chinadns-ng / dns2socks / geoview 等包仍可能来自该源。
#        如确认不再需要，可自行在 workflow 的 FEEDS 中删除 helloworld 行。
# ============================================================================


# ============================================================================
#  四、DNS（PassWall 依赖 dnsmasq-full）
# ============================================================================
CONFIG_PACKAGE_dnsmasq_full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y


# ============================================================================
#  五、nftables（fw4 透明代理依赖）
# ============================================================================
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_nftables-json=y


# ============================================================================
#  六、辅助工具
# ============================================================================
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
# dns2tcp 为 ssr-plus 专用，随 ssr-plus 一并移除
# CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_xray-core=y
# CONFIG_PACKAGE_geoview=y
#   ↑ v1.7.11 移除：geoview 是 Go 项目，仅 PassWall 的【Sing-box 分流】
#     需要它（PassWall 25.3.9+ 起 Sing-box 依赖 geoview 从 Geofile 生成规则集）。
#     本配置用 Xray 分流，不用 Sing-box，故完全不需要。
#     且其上游存在「geoview is selected by geoview」自我依赖问题
#     （kenzok8/small issue #210），在 3 秒内即失败，是本次构建失败的直接原因。
#     重新启用：去掉本行行首的 "# "。
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y


# ============================================================================
#  七、iStore 应用商店（linkease/istore @main）
# ============================================================================
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils-stty=y

# 注意：不要写 luci-i18n-store-zh-cn，iStore 无标准 po/


# ============================================================================
#  八、Lucky（gdy666/luci-app-lucky @main）
#      公网神器：端口转发 / 反向代理 / DDNS / WOL / STUN 内网穿透 /
#                cron / acme / rclone / ftp / webdav / filebrowser
#
#      结构（该 feed 仓库顶层有两个包目录，非标准 feeds 布局，
#            OpenWrt 的 scan.mk 递归扫描 -mindepth 1 -name Makefile，可正确发现）：
#        lucky/Makefile          主程序 v2.27.2，SECTION=net
#        luci-app-lucky/Makefile LuCI 界面 v2.2.2，LUCI_DEPENDS=+lucky +luci-compat
#
#      ⚠ 重要：lucky 主程序【不编译 Go 源码】，
#        而是 Build/Prepare 阶段 wget 下载 GitHub Releases 上的预编译二进制：
#          lucky_2.27.2_Linux_arm64.tar.gz   （aarch64 → arm64，已确认支持）
#        ⇒ 编译很快，但构建时【必须能访问 GitHub Releases】。
#          GitHub Actions 托管 runner 在境外，正常可达。
#
#      luci-app-lucky 的 po/ 目录含 zh_Hans，故中文包可正常生成。
# ============================================================================
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y


# ============================================================================
#  九、ddns-go —— 已禁用（v1.7.4）
#
#      【禁用原因：连续多轮在此包编译失败，阻塞固件产出】
#        ERROR: package/feeds/packages/ddns-go failed to build.
#
#      已尝试的修复（均未解决）：
#        · v1.7.3 修正 Go module 缓存路径 tmp/go-mod-cache → dl/go-mod-cache
#          （依据 golang-values.mk: GO_MOD_CACHE_DIR:=$(DL_DIR)/go-mod-cache）
#          ——路径确实写错了，但修正后仍然失败。
#          推测：正确路径下缓存首次为空，仍需重新下载数百 MB Go 依赖，
#                网络抖动导致失败；也可能与 Go 编译内存峰值有关。
#
#      【结论】ddns-go 是纯 Go 项目，编译开销大且不稳定，
#              而它并非核心功能（PassWall 已覆盖主要需求）。
#              为保证固件能稳定产出，先禁用。
#
#      【日后如何重新启用】
#        把下面三行前面的 "# " 去掉即可：
#          CONFIG_PACKAGE_luci-app-ddns-go=y
#          CONFIG_PACKAGE_ddns-go=y
#          CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
#
#        若重新启用后仍失败，建议改用：
#          · ddns-scripts（官方源，纯 shell，几乎不会编译失败）
#          · 或刷机后通过 iStore 在线安装 ddns-go（无需重新编译固件）
#
#      注：ca-bundle 是很多包的公共依赖，保留不动。
# ============================================================================
# CONFIG_PACKAGE_luci-app-ddns-go=y
# CONFIG_PACKAGE_ddns-go=y
# CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
CONFIG_PACKAGE_ca-bundle=y

# ============================================================================
# ============================================================================
#  十、OpenAppFilter / OAF —— 应用过滤 / 家长控制（v1.7.6 重新启用）
#
#      来源：destan19/OpenAppFilter @master（feed 名 oaf）
#      版本：appfilter 7.0.1 · luci-app-oaf 7.0 · kmod-oaf（内核模块）
#
#      ⚠ 包名与目录名【完全不一致】，容易踩坑：
#          目录 open-app-filter/  → 包 appfilter        （用户态守护进程）
#          目录 oaf/              → 包 kmod-oaf         （内核 netfilter 模块）
#          目录 luci-app-oaf/     → 包 luci-app-oaf     （LuCI 界面）
#
#      ⚠ 历史问题：v1.7.1 曾因此包导致整个构建失败
#          tmp/.config-package.in:error: recursive dependency detected!
#          symbol PACKAGE_kmod-oaf is selected by PACKAGE_kmod-oaf
#        → kmod-oaf 被 kconfig 静默丢弃、从未编译
#        → 安装阶段 appfilter / luci-app-oaf 依赖缺失
#        → package/install Error 255 → 构建失败
#
#      【关于根因 —— 需要诚实说明】
#        本次重新审查了三个 Makefile（oaf / open-app-filter / luci-app-oaf），
#        【没有】发现显式的自引用（kmod-oaf 的 DEPENDS 只有 kmod-ipt-conntrack，
#        luci-app-oaf 的 LUCI_DEPENDS 是 appfilter+kmod-oaf+luci-compat+
#        luci-lib-jsonc）。也确认源码树里【没有】预置 OAF，不存在重复定义。
#        ⇒ 静态分析无法定位，只能实测。
#
#      【本次的防护：编译前自检 + 自动跳过】
#        workflow 里新增一步：载入配置后检查 .config
#        · 若 luci-app-oaf=y 但 CONFIG_PACKAGE_kmod-oaf 【不在】 .config
#          ⇒ 说明递归依赖又出现了，kmod-oaf 会被丢弃，
#            继续编下去必然在最后 opkg 安装阶段失败（白等 3 小时）。
#          ⇒ 此时自动把 OAF 三行注释掉再继续，保证仍能出固件，
#            并在日志与 Release 正文里明确标注「OAF 未包含」。
#
#      【功能前提：必须关闭硬件加速】
#        OAF 靠 netfilter 钩子抓包识别应用。开启 MTK HNAT/PPE 后
#        流量绕过 CPU，OAF 将【完全识别不到任何应用】（静默失效）。
#        本仓库 HW_OFFLOAD:0（出厂默认关闭），符合要求。
#        若手动开启硬件加速，OAF 会失效。
#
#      【若构建成功，如何验证 OAF 真的可用】
#        SSH 执行：lsmod | grep oaf      → 应有 oaf 模块
#                  opkg list-installed | grep -E "appfilter|oaf"
#        界面：服务 → 应用过滤
# ============================================================================
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
#  十一、Watchcat（官方源内置，无需第三方 feed）
#       定时 ping 检测 / 网络不通自动重启接口或整机重启
#
#       watchcat        v1-r17  → immortalwrt/packages utils/watchcat
#       luci-app-watchcat       → immortalwrt/luci applications/luci-app-watchcat
#       LUCI_DEPENDS = +luci-base +watchcat
#       po/ 含 zh_Hans，中文包可正常生成
# ============================================================================
CONFIG_PACKAGE_luci-app-watchcat=y
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_luci-i18n-watchcat-zh-cn=y


# ============================================================================
#  十二、Diskman 磁盘管理 —— 暂时禁用（v1.7.5）
#
#      【为什么禁用：它是本次构建失败的最大嫌疑】
#
#      事实链（对比仓库提交实测得出）：
#        · 最后一次【成功】构建是提交 8dc33bf（2026-09-05），
#          当时的包集合【没有】Diskman。
#        · 之后所有失败的运行，相比 8dc33bf 唯一【新增】的包就是这一组：
#            blkid / block-mount / kmod-fs-ext4 / kmod-tcp-bbr
#            luci-app-diskman / luci-i18n-diskman-zh-cn
#            INCLUDE_lsblk / INCLUDE_btrfs_progs
#          （其余全是【移除】：ssr-plus、OAF、ddns-go、dns2tcp）
#        · 移除 ddns-go 后的 v1.7.4 跑了 3h56m 仍失败（run #7），
#          说明 ddns-go 已不是阻塞点，嫌疑转移到这一组。
#
#      【为何重点怀疑 luci-app-diskman 这一组】
#        它通过 LUCI_DEPENDS 拉起一大串重依赖：
#          blkid(util-linux) e2fsprogs parted smartmontools dosfstools
#          kmod-fs-msdos kmod-fs-ntfs3 kmod-fs-exfat
#          exfat-mkfs exfat-fsck kmod-nls-cp932/cp936/cp950
#        外加显式开启的 btrfs-progs 与 lsblk。
#        其中 btrfs-progs / util-linux 都是体量不小、且历史上
#        在交叉编译时出过问题的包。
#
#      【保留的部分】
#        kmod-fs-ext4 / block-mount / blkid 三个【不禁用】——
#        它们是下面第十三节「eMMC 剩余空间自动挂载」的依赖，
#        且都是小体积包，嫌疑低。见下一节。
#
#      【如何重新启用】
#        把下面 4 行前面的 "# " 去掉即可。
#        建议等先用当前配置成功出包并验证稳定后，再单独启用这一组重试，
#        这样一旦失败能立刻锁定是不是它。
#
#      注：不装 Diskman 不影响 eMMC 自动挂载（那是由 uci-defaults
#          脚本完成的，不依赖 LuCI 界面）。只是少了图形化的
#          分区/格式化/SMART 检测界面。
# ============================================================================
# CONFIG_PACKAGE_luci-app-diskman=y
# CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
# CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y


# ============================================================================
#  十三、eMMC 剩余空间：自动分区 + 自动挂载
#
#       背景：CMCC XR30 eMMC 算力版是 64GB，固件只用了前面一小部分，
#             剩余约 54–57GB 默认用不上。但这块空间有【两种形态】，
#             取决于你刷的 GPT 分区表，脚本两条路都覆盖：
#
#         形态 A：剩余空间【已经是一个分区】（如 mmcblk0p12，55.9G）
#                 只是没有挂载点 → 格式化（若需要）并挂载即可
#         形态 B：剩余空间【根本没有分区】，只是未分配空间
#                 恩山多个帖子实测："进入系统后发现 emmc 没有挂载上，
#                 默认是没有分区的，有一部分闲置空间" → 必须先建分区
#
#       ⚠ v1.7.7 修正：之前只覆盖形态 A，且【漏了三个必需包】，
#         导致形态 B 下 mkfs.ext4 / fdisk 根本不存在，脚本直接跳过。
#
#       所需包（util-linux 子包几乎零成本，因为 blkid 已启用）：
#         kmod-fs-ext4   挂载 ext4 的内核模块（defconfig 默认没有！）
#         block-mount    提供 /etc/config/fstab 与 block 工具
#         blkid          识别分区文件系统类型
#         e2fsprogs      ★ mkfs.ext4（v1.7.7 补齐，之前遗漏）
#         fdisk          ★ 在剩余空间上新建分区（v1.7.7 补齐）
#         partx-utils    ★ 让内核重读分区表（v1.7.7 补齐）
#
#       自动挂载动作由 files/etc/uci-defaults/zzz-emmc-mount 完成：
#         形态 A → 格式化（若需要）+ 挂载
#         形态 B → 新建分区 → 内核重读分区表 → 格式化 + 挂载
#                  若内核读不到新分区（eMMC 常见），自动重启一次，
#                  下次启动走 A 路径完成。重启标记文件防重复分区。
#         挂载到 /mnt/emmc，并写入 fstab 开机自动挂载。
#
#       ⚠ 安全：绝不删除或修改任何已有分区，只在未分配空间上新建；
#         跳过 rootfs/overlay、已挂载分区；只处理大于 2GB 的空间；
#         只在 blkid 完全识别不到文件系统时才格式化；全程幂等。
#
#       ⚠ 格式化会销毁该空间上的数据。若上面还有需要的内容，
#         请刷机【前】备份，或刷机后删除该 uci-defaults 再重启。
# ============================================================================
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_partx-utils=y


# ============================================================================
#  十四、Harbor File Pro 文件管理（v1.7.8 新增）
#
#      来源：whzhni1/luci-app-harbor-file-pro @main（feed 名 harbor）
#      版本：1.0.2（ucode 后端，原版 destan19/luci-app-harbor-file 的重写版）
#
#      【仓库结构：标准 feed】
#        顶层是包目录 luci-app-harbor-file-pro/ → 可直接当 feed 用，
#        ⚠ 注意 feed URL 指向【仓库根】，不是包目录：
#             harbor https://github.com/whzhni1/luci-app-harbor-file-pro.git;main
#           （对比：有些仓库顶层【就是】包，那种不能当 feed，需 clone 到 package/）
#
#      【Pro 版 vs 原版】
#        Pro：ucode 重写，代码量减 60%，内存占用更低，需 OpenWrt 22.03+
#             下载功能剥离为独立 CGI，浏览器原生流式下载，大文件不占内存
#        原版：Lua 实现，21.02+
#        ⇒ 我们固件是 24.10，两者都支持，选 Pro（架构更现代）
#
#      【依赖（LUCI_DEPENDS 自动拉起，已逐个验证在源码树中存在）】
#        luci-base          LuCI 基础
#        rpcd               ubus RPC 后端
#        rpcd-mod-file      ★ 文件/目录操作（rpcd 的 BuildPlugin 宏动态定义）
#        ucode              ucode 解释器
#        ucode-mod-fs       ★ 文件系统模块（ucode 的 UcodeModule 宏动态定义）
#        ucode-mod-ubus     ★ ubus 模块
#        ucode-mod-uci      ★ uci 模块
#
#        ⚠ 这 4 个 ★ 的包是【宏动态生成】的子包，
#          光 grep "define Package/" 是找不到的（只有 libucode / ucode、
#          rpcd 三个静态定义）。已通过阅读 Makefile 全文确认存在。
#        ⇒ 不会重蹈 kmod-oaf 覆辙（依赖缺失 → 最后安装阶段失败 → 白等 3 小时）
#
#      【额外成本极低】
#        24.10 的 luci-base 本身就依赖 ucode，
#        所以 ucode / ucode-mod-* 大概率已在固件中；
#        真正新增的只有 rpcd-mod-file 与少量 ucode 模块，体积很小。
#
#      【中文】
#        po/ 含 zh_Hans → luci-i18n-harbor-file-pro-zh-cn 可正常生成
#
#      【用途】
#        LuCI 网页端文件管理：浏览/上传/下载/编辑/压缩解压、
#        图片缩略图、视频在线播放、命令行终端。
#        配合 eMMC 自动挂载的 /mnt/emmc，等于一台轻量 NAS。
# ============================================================================
CONFIG_PACKAGE_luci-app-harbor-file-pro=y
CONFIG_PACKAGE_luci-i18n-harbor-file-pro-zh-cn=y
