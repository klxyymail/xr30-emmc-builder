# ============================================================================
#  插件配置片段 —— SSR-PLUS / PASSWALL / ARGON / ISTORE / DDNS-GO
#  目标源码: padavanonly/immortalwrt-mt798x-6.6 分支 openwrt-24.10-6.6
#  机型:     CMCC XR30 eMMC (设备目标 cmcc_rax3000m-emmc-mtk)
#
#  本文件由 workflow 追加到 defconfig 生成的 .config 末尾，再执行 make defconfig
#  依赖会自动展开，下面只是"选装项"的开关
#
#  【核查结论 - 2026-09-05 实测】
#  1. luci-app-passwall   v25.12.16  —— immortalwrt/luci 官方源已内置，无需加源
#  2. luci-theme-argon    v2.4.3     —— immortalwrt/luci 官方源已内置，无需加源
#  3. luci-app-ddns-go    ——          —— immortalwrt/luci 官方源已内置，无需加源
#     ddns-go v6.11.2 在 immortalwrt/packages 的 net/ 下，Go 程序
#  4. luci-app-ssr-plus   v196       —— 官方源没有，需追加 fw876/helloworld 源
#     该源同时提供官方缺失的: shadowsocksr-libev / shadowsocks-libev /
#     mosdns / dnsproxy / dns2socks-rust / gn
#  5. luci-app-store      v0.2.1-r1  —— 官方源没有，需追加 linkease/istore 源
#     该源同时提供: luci-lib-taskd / luci-lib-xterm / taskd
#
#  【依赖链核查（均已满足，无缺失）】
#  luci-app-store
#    ├─ curl / tar / libuci-lua          base 自带
#    ├─ mount-utils                      util-linux 子包
#    └─ luci-lib-taskd (>=1.0.19)  ── istore 源
#         ├─ luci-lib-xterm        ── istore 源
#         └─ taskd (>=1.0.3)       ── istore 源（纯 shell，基于 procd，非 Go）
#              └─ procd / script-utils / coreutils / coreutils-stty
#
#  ⚠ script-utils 与 mount-utils 在源码树里【没有独立目录】，
#    它们是 package/utils/util-linux 内部定义的子包（同 v2ray-geoip 的情形）。
#    按目录名去找会 404，但依赖能被自动解析，无需手动干预。
#
#  ⚠ luci-app-store【没有标准 po/ 目录】，因此 luci-i18n-store-zh-cn 不会生成。
#    它的中文由 istore-ui 前端自带（仓库 translations/zh-cn/app.po）。
#    切勿在配置里写 luci-i18n-store-zh-cn，会被静默丢弃。
#
#  【兼容性】
#  24.10 默认 firewall4(nftables)。passwall 依赖 kmod-nft-socket/tproxy/nat，
#  为 nftables 原生；ssr-plus 在 dev 分支声明
#  "default Nftables_Transparent_Proxy if PACKAGE_firewall4"，二者均已适配 fw4。
#  本配置显式指定 nftables 模式，不回退 iptables。
# ============================================================================


# ============================================================================
#  一、Argon 主题（官方源内置，依赖 wget + jsonfilter，无额外负担）
# ============================================================================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y


# ============================================================================
#  二、PassWall（官方源内置 v25.12.16）
#      必需依赖 coreutils / curl / chinadns-ng / dns2socks / ip-full /
#      libuci-lua / lua / luci-compat / luci-lib-jsonc / microsocks /
#      resolveip / tcping / unzip / ipt2socks / kmod-nft-socket /
#      kmod-nft-tproxy / kmod-nft-nat —— 全部由 make defconfig 自动展开
# ============================================================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

# --- 核心与分流数据（建议保留）---
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y   # v2ray-geoip + v2ray-geosite
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview=y   # geoview，分流规则提取
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=y

# --- 默认开启但本场景用不到，显式关闭（haproxy 在 aarch64 默认 default y）---
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set

# --- 重量级可选核心：编译极慢（Go/Rust），默认关闭 ---
#    需要时取消注释。同时开启多项有触发 Actions 6 小时超时的风险。
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y        # Go，约 15-30 min
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y   # Rust，约 30-60 min
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y       # Go
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=y     # Go，编译很慢
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS=y     # Rust
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client=y    # Rust
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Brook=y           # Go


# ============================================================================
#  三、luci-app-ssr-plus（来自 fw876/helloworld @dev，v196）
#
#  ⚠ 关键：官方 defconfig 里预置了三个 "NONE" 选项且为 =y，含义是"不装任何核心"。
#    若不显式关掉，编出来的 ssr-plus 会是个空壳（无 Xray、无 SS 内核）。
#    下面先把它们置为 not set，再开启真正需要的核心。
# ============================================================================
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NONE_V2RAY is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_NONE_Server is not set

CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_luci-i18n-ssr-plus-zh-cn=y

# --- 透明代理模式：明确走 nftables（fw4），不要用 iptables ---
CONFIG_PACKAGE_luci-app-ssr-plus_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-ssr-plus_Iptables_Transparent_Proxy is not set

# --- 核心：Xray（与 passwall 共用同一个 xray-core，不会重复编译）---
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray=y

# --- SSR 协议支持（shadowsocksr-libev 仅 helloworld 源提供，官方源没有）---
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Client=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Libev_Server is not set

# --- DNS 分流 ---
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ChinaDNS_NG=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNS2SOCKS=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_MosDNS is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_DNSPROXY is not set

# --- 其它协议：按需开启，注意编译耗时 ---
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Trojan=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Redsocks2=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_IPT2Socks=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_V2ray_Plugin=y
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Libev_Client is not set  # helloworld 提供，可选
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks_Rust_Client is not set   # Rust，很慢
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Hysteria is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Tuic_Client is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Kcptun is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_V2ray is not set   # 与 Xray 二选一，推荐 Xray


# ============================================================================
#  四、DNS：ssr-plus 硬依赖 dnsmasq-full（需要 ipset/nftset 支持）
#      必须替换默认的 dnsmasq，否则 ssr-plus 的域名分流规则无法生效。
#      passwall 同样受益于此。
# ============================================================================
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq_full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y
CONFIG_PACKAGE_dnsmasq_full_dnssec=y

# dnsmasq-full 的可选功能，按需开启
CONFIG_PACKAGE_dnsmasq_full_auth=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_ipset=y


# ============================================================================
#  五、nftables 支持（fw4 透明代理依赖，确保内核模块被编入）
#      注：mediatek target 的 DEFAULT_PACKAGES 已含 kmod-nft-socket /
#      kmod-nft-tproxy / kmod-nft-nat，此处显式声明以防被裁剪。
# ============================================================================
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y

# nft 命令行工具（调试分流规则时有用）
CONFIG_PACKAGE_nftables-json=y


# ============================================================================
#  六、辅助工具（ssr-plus / passwall 运行时会用到）
# ============================================================================
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_resolveip=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y


# ============================================================================
#  七、iStore 应用商店（来自 linkease/istore @main，v0.2.1-r1）
#
#      依赖链:
#        luci-app-store
#          ├─ curl / tar / libuci-lua / mount-utils     base + util-linux 子包
#          └─ luci-lib-taskd (>=1.0.19)
#               ├─ luci-lib-xterm
#               └─ taskd (>=1.0.3)  →  procd / script-utils /
#                                       coreutils / coreutils-stty
#      以下四项全部由 make defconfig 自动展开，无需逐个写。
#
#      ⚠ 不要写 CONFIG_PACKAGE_luci-i18n-store-zh-cn
#        iStore 没有标准 po/ 目录，该 i18n 包不会被生成，
#        写进去会被 make defconfig 静默丢弃。
#        中文由 istore-ui 前端自带（translations/zh-cn/app.po）。
# ============================================================================
CONFIG_PACKAGE_luci-app-store=y

# 显式拉上依赖链，避免上游调整依赖时被意外裁剪
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y

# taskd 依赖（util-linux 子包 + coreutils 组件，平时由依赖自动带入，
# 显式写出以便 make defconfig 校验依赖完整性）
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_coreutils-stty=y


# ============================================================================
#  八、动态 DNS —— ddns-go（Go 版，官方源内置）
#
#      luci-app-ddns-go  →  immortalwrt/luci  @openwrt-24.10   官方内置
#      ddns-go v6.11.2   →  immortalwrt/packages net/ddns-go   官方内置
#
#      注：与传统的 luci-app-ddns（ddns-scripts）是【两套不同实现】，
#          二者可共存，但建议只启用一套以免端口/配置冲突。
#          本配置启用 ddns-go，不启用 ddns-scripts。
# ============================================================================
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y

# Go 程序都需要 ca-bundle 做 HTTPS 证书校验，显式拉上
CONFIG_PACKAGE_ca-bundle=y

# 传统 ddns-scripts 方案（默认关闭，如需与 ddns-go 共存可取消注释）
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_ddns-scripts is not set
